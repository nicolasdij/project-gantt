# Dockerfile de DESARROLLO para el server (Fastify + Prisma).
# El código se monta como volumen (ver docker-compose.yml) para hot-reload con tsx watch.
FROM node:22-alpine

WORKDIR /app

# Instala dependencias primero para aprovechar la caché de capas.
COPY package.json package-lock.json* ./
RUN npm install

# Copia el resto (en dev queda sobrescrito por el bind-mount, pero sirve para build standalone).
COPY . .

# Genera el cliente de Prisma a partir del schema.
RUN npx prisma generate

EXPOSE 3000

# Al arrancar: aplica migraciones pendientes y levanta el server con hot-reload.
CMD ["sh", "-c", "npx prisma migrate deploy && npm run dev"]
